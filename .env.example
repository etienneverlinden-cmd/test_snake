# Convex (copy values after `npx convex dev`)
# Public URL — also paste into js/convex-config.js for the static site.
# Live production site uses the *dev* deployment (limitless-duck-213), not Convex "prod".
# Ship backend with: npx convex dev --once   (NOT npx convex deploy)
CONVEX_URL=https://YOUR_DEPLOYMENT.convex.cloud
CONVEX_DEPLOYMENT=dev:YOUR_DEPLOYMENT

# Auth — set these on the Convex deployment with `npx convex env set ...`
# (see AUTH.md). Do not commit real secrets.
# SITE_URL=http://localhost:8080
# AUTH_GOOGLE_ID=
# AUTH_GOOGLE_SECRET=
# AUTH_RESEND_KEY=
# AUTH_EMAIL_FROM=PragmatICT <onboarding@resend.dev>
# ADMIN_EMAIL=you@yourdomain.com
# CONVEX_SITE_URL is a Convex system var (*.convex.site) — always injected; do not set it.
# JWT_PRIVATE_KEY=
# JWKS=
