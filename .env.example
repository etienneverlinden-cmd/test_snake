# Convex (copy values after `npx convex dev`)
# Public URL — also paste into js/convex-config.js for the static site
CONVEX_URL=https://YOUR_DEPLOYMENT.convex.cloud
CONVEX_DEPLOYMENT=dev:YOUR_DEPLOYMENT

# Auth — set these on the Convex deployment with `npx convex env set ...`
# (see AUTH.md). Do not commit real secrets.
# SITE_URL=http://localhost:8080
# AUTH_GOOGLE_ID=
# AUTH_GOOGLE_SECRET=
# AUTH_RESEND_KEY=
# AUTH_EMAIL_FROM=Stijn Arcade <onboarding@resend.dev>
# JWT_PRIVATE_KEY=
# JWKS=
