[Unit]
Description=Pragmatict headless Cursor agent worker
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=cursor-worker
Group=cursor-worker
WorkingDirectory=/opt/cursor-worker/work
EnvironmentFile=-/etc/pragmatict/cursor.env
Environment=PATH=/opt/cursor-worker/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/opt/cursor-worker/bin/worker.sh
Restart=always
RestartSec=10
# Keep secrets out of process listings where possible
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
